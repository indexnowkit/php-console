{
    "name": "indexnowkit/console",
    "description": "Console runners for indexnowkit: the bodies of the check, submit, submit-<subject>, explain and key:generate commands of every framework adapter, and the one declaration of their arguments and options (symfony/console)",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "console",
        "cli",
        "symfony-console",
        "seo"
    ],
    "homepage": "https://indexnowkit.github.io/php/console/",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-console",
        "docs": "https://github.com/indexnowkit/php-console/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-console/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "indexnowkit/core": "^0.7",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "justinrainbow/json-schema": "^6.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Console\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
